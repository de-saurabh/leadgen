# Copy to .env (repo root) and adjust. Variables for later milestones are added as they land.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://leadgen:leadgen@localhost:5433/leadgen

# Sessions/cookies. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Platform admin (you). Created on API boot if both are set; safe to leave set.
PLATFORM_ADMIN_EMAIL=admin@leadgen.local
PLATFORM_ADMIN_PASSWORD=change-me-admin

# Production / single-service deploys only: serve the built dashboard from the API.
# WEB_DIST_DIR=apps/web/dist
